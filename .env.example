# GNews API (https://gnews.io)
GNEWS_API_KEY="your_gnews_api_key"

# Anthropic (요약/인사이트 생성)
ANTHROPIC_API_KEY="your_anthropic_api_key"
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Hugging Face Inference API (finetune/으로 학습해 push한 요약 모델, SUMMARIZER_PROVIDER=hf일 때 사용)
HF_API_TOKEN="your_hf_api_token"
HF_MODEL_ID="your-username/briefyi-qwen3-8b-summarize"

# 요약 provider 선택: anthropic(기본) | hf
SUMMARIZER_PROVIDER=anthropic

# 이메일 발송 (Resend 사용 예시. SMTP로 바꾸려면 tools/email_send.py 참고)
RESEND_API_KEY="your_resend_api_key"
EMAIL_FROM="onboarding@resend.dev"
EMAIL_TO="you@example.com"

# 파이프라인 파라미터
NEWS_KEYWORD=AI
NEWS_LOOKBACK_DAYS=1
NEWS_MAX_RESULTS=10

# 저장소 (PostgreSQL, docker-compose의 db 서비스)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=briefyi
POSTGRES_USER=briefyi
POSTGRES_PASSWORD=briefyi
# DATABASE_URL을 직접 주면 위 POSTGRES_* 대신 이 값을 그대로 쓴다 (컨테이너 안에서는 host가 db)
# DATABASE_URL="postgresql://briefyi:briefyi@db:5432/briefyi"

# 실행 모드 / 트리거
RUN_MODE=single
TRIGGER_INTERVAL_SECONDS=86400

# ── data_pipeline/ (docs/data-pipeline-design.md) ──────────────────────────
# 파인튜닝 안 한 기본 모델을 HF 무료 서버리스로 호출해 학습 데이터를 만드는
# 별도 파이프라인이다. 위 POSTGRES_*/GNEWS_*/HF_API_TOKEN은 그대로 같이 쓰고,
# 아래는 이 파이프라인 전용 값이다. .env는 레포 루트 하나로 통합 관리한다
# (data_pipeline/에는 별도 .env를 두지 않는다).
#
# 기본값은 Groq다. HF Inference Providers는 무료 계정 월 $0.10 크레딧뿐이고 그마저
# 카드 등록이 있어야 라우팅이 열려서(등록 안 하면 provider를 명시해도
# model_not_supported로 거부됨) 이 파이프라인 규모엔 실질적으로 못 쓴다. Groq
# 무료 티어는 카드 등록 없이 30 req/min · 6000 tokens/min · 14400 req/day를 준다.
DATA_PIPELINE_LLM_PROVIDER=groq

# Groq (기본값) — https://console.groq.com/keys 에서 발급, 카드 등록 불필요
GROQ_API_KEY="your_groq_api_key"
DATA_PIPELINE_GROQ_MODEL="llama-3.3-70b-versatile"

# HF (DATA_PIPELINE_LLM_PROVIDER=hf로 바꿨을 때만 사용하는 대체 경로)
# DATA_PIPELINE_HF_MODEL_ID는 위 HF_MODEL_ID(메인 앱이 쓰는, 직접 파인튜닝해 push한
# 모델)와 반드시 다른 값이어야 한다 — 여기는 학습 데이터를 만들 때 쓰는, 파인튜닝
# 안 한 베이스 모델을 가리킨다.
DATA_PIPELINE_HF_MODEL_ID="Qwen/Qwen2.5-14B-Instruct"
# HF Inference Providers 자동 라우팅("auto")이 계정에서 활성화 안 한 provider로
# 붙으려다 model_not_supported로 실패하는 걸 막기 위해 명시적으로 고정한다.
# https://huggingface.co/settings/inference-providers 에서 활성화한 provider와
# 반드시 일치해야 한다.
DATA_PIPELINE_HF_PROVIDER=featherless-ai

# Groq 무료 티어(30 req/min)에 안전 마진을 둔 기본값. 다른 provider로 바꾸면 재조정할 것.
RATE_LIMIT_MAX_REQUESTS=25
RATE_LIMIT_WINDOW_SECONDS=60
LLM_MAX_RETRIES=5
KEYWORD_TOP_N=5
KEYWORD_EMBEDDING_MODEL="paraphrase-multilingual-MiniLM-L12-v2"
SYNONYM_CLUSTER_THRESHOLD=0.82
SYNONYM_FUZZY_THRESHOLD=0.85
SYNONYM_TABLE_VERSION=v1
BATCH_LIMIT=20
